@baseUrl=http://localhost:8080/api/members

### member list
GET {{baseUrl}}/

### member-regist
POST {{baseUrl}}
Content-Type: application/json

{
  "title": " ",
  "body": "body 1",
  "writer": "1"
}

### member-regist
POST {{baseUrl}}
Content-Type: application/json

{
  "nickname": "guest",
  "email": "guest@email.com",
  "passwd": "xxxxxxxx",
  "bloodType": "O",
  "isActive": true
}

### member-info
GET {{baseUrl}}/1


### member-update
PUT {{baseUrl}}/4
Content-Type: application/json

{
  "id": 4,
  "nickname": "guestxx",
  "email": "guest@email.comxx",
  "passwd": "xxxxxxxx",
  "bloodType": "O",
  "isActive": false
}

### withdraw member
DELETE {{baseUrl}}/4

### search isActive
GET {{baseUrl}}/search?isActive=true

### search isActive 0
GET {{baseUrl}}/search?isActive=0

### search isActive bloodType
GET {{baseUrl}}/search?isActive=1&bloodType=B

### search member nickname
GET {{baseUrl}}/search?nickname=hong

### search date
GET {{baseUrl}}/search?datetime=2026-03-05 15:16:25

### search date
GET {{baseUrl}}/search?datetime=2026-03-05

### search date
GET {{baseUrl}}/search?datetime=2026-03-05 09:16
