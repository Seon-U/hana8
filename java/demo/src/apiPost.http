#GET {{baseUrl}}/search?title="TEST1"

### post search
GET {{baseUrl}}?page=1&title=Title8

### post search
GET {{baseUrl}}?page=1&title=Title8&body=body of 8

### post search
GET {{baseUrl}}?page=1&title=Title8&writer=writer80

### post search
GET {{baseUrl}}?page=1&title=Title8&writedate=2026-03-05


### post - update
PUT {{baseUrl}}/101
Content-Type: application/json

{
  "id": 107,
  "title": "title 1x",
  "body": {
    "id": 104,
    "body": "body 1xxx"
  },
  "writer": "Hongxxx"
}

### get post
GET {{baseUrl}}/92

### get replies
GET {{baseUrl}}/92/replies

### add reply
POST {{baseUrl}}/92/replies
Content-Type: application/json

{
  "reply": "reply 1111",
  "replier": "hong"
}

### get reply
GET {{baseUrl}}/92/replies/1

### edit reply
PUT {{baseUrl}}/92/replies/1
Content-Type: application/json

{
  "id": 1,
  "reply": "reply xxxxxxx"
}


### delete reply
DELETE {{baseUrl}}/102/replies/1
