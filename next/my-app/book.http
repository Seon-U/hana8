@api = http://localhost:3000/post/api
### book list
GET {{api}}/books

### add book
POST {{api}}/books

{
  "title": "New book",
  "writer": "su"
}

### get a book fetch().then(res => json())

GET {{api}}/books/22

### patch book

PATCH {{api}}/books/2

{
  "title": "test2 book"
}

### another patch
PATCH {{api}}/books/2

{
  "title": "New Title",
  "author": "New author"
}

### patch a book error test
PATCH {{api}}/books/23

{
  "title": "New title",
  "writer": "jade"
}

### delete a book
 
DELETE {{api}}/books/2